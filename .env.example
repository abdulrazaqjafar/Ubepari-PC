# PostgreSQL connection (required on Vercel for Build + Runtime)
# Example Neon/Supabase/Vercel Postgres:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
DATABASE_URL="postgresql://ubepari:ubepari@localhost:5432/ubepari_pc?schema=public"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-long-random-secret"

# Public site URL (local or Vercel domain)
AUTH_URL="http://localhost:3000"
# On Vercel Production use:
# AUTH_URL="https://your-project.vercel.app"
